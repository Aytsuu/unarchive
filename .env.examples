# Local development only. Change both password values together before starting MongoDB.
MONGO_INITDB_ROOT_USERNAME=unarchive_dev
MONGO_INITDB_ROOT_PASSWORD=replace_with_a_local_password
MONGODB_URI=mongodb://unarchive_dev:replace_with_a_local_password@127.0.0.1:27017/unarchive?authSource=admin
MONGODB_DB_NAME=unarchive
MONGO_ENABLE_TRANSACTIONS=false

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret
BETTER_AUTH_URL=http://localhost:3000

# Configure a Google OAuth web client and a verified Resend sender.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
